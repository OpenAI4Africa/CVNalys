# CVNalys Configuration
SECRET_KEY=your-secret-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Production: set FLASK_ENV=production or PRODUCTION=1 for secure session cookies
# FLASK_ENV=production

# Optional: comma-separated origins for CORS (leave empty for default / same-origin)
# CORS_ORIGINS=https://yourdomain.com,http://127.0.0.1:8000

# Optional: Database configuration
# DATABASE_URL=sqlite:///cvnalys.db

# Optional: File upload settings
# MAX_FILE_SIZE=16777216
